//create a window
if (`window -exists myWindow`) {
    deleteUI myWindow;
}
window -title "3D Sword Creator" -widthHeight 300 200 myWindow;

//Create a layout
columnLayout;

//Create buttons for each section of the script
button -label "Create Blade" -command "createBlade()";
button -label "Create Guard" -command "createGuard()";
button -label "Create Hilt" -command "createHilt()";
button -label "Apply Shader" -command "applyShader()";

//Show the Window
showWindow myWindow;

//Define the functions for each button
global proc createBlade() {
    CreatePolygonCube;
    scale -r 1 10 1;
    rename "pCube1" "Blade";
    move 0 4 0;
    polySplit -ch 1 -sma 180 -ep 0 0.505771 -ep 1 0.505771 -ep 2 0.505771 -ep 3 0.505771 -ep 0 0.505771 |Blade|BladeShape;  select -cl;
    select -r Blade.vtx[9:10] ;
    move -r 0 1.106371 0 ;
}

global proc createGuard() {
    CreatePolygonCube;
    scale -r 5 1 1;
    rename "pCube1" "Guard";
    move 0 1.5 0;
    polySplit -ch 1 -sma 180 -ep 4 0.501551 -ep 8 0.498449 -ep 9 0.498449 -ep 5 0.501551 -ep 4 0.501551 |Guard|GuardShape;  select -cl;
    select -r Guard.vtx[8:11] ;
    scale -r -p 0cm 2.001551cm 0cm 1.244444 1 1 ;
    select -r Guard ;
    scale -r 1 1 1.301965 ;
}

global proc createHilt() {
    CreatePolygonCube;
    scale -r 1 3 1;
    rename "pCube1" "Hilt";
    move 0 0 0;
    select -r Hilt ;
    scale -r 1.126899 1 1.126899 ;
}

// shader
global proc applyShader() {
    shadingNode -asShader lambert -name "myLambert";
sets -renderable true -noSurfaceShader true -empty -name "myLambertSG";
connectAttr -f "myLambert.outColor" "myLambertSG.surfaceShader";


select "Blade";
sets -e -forceElement "myLambertSG";


setAttr "myLambert.color" -type double3 0.535 0.535 0.535 ;


shadingNode -asShader lambert -name "myLambert1";
sets -renderable true -noSurfaceShader true -empty -name "myLambertSG1";
connectAttr -f "myLambert1.outColor" "myLambertSG1.surfaceShader";

select "Guard";
sets -e -forceElement "myLambertSG1";

setAttr "myLambert1.color" -type double3 2.708 2.283205 0 ;


shadingNode -asShader lambert -name "myLambert2";
sets -renderable true -noSurfaceShader true -empty -name "myLambertSG2";
connectAttr -f "myLambert2.outColor" "myLambertSG2.surfaceShader";

select "Hilt";
sets -e -forceElement "myLambertSG2";

setAttr "myLambert2.color" -type double3 0 0 0;


select -r Blade Hilt Guard ;
doGroup 0 1 1;
rename "group1" "Sword";
}

//create a window
if (`window -exists myWindow`) {
    deleteUI myWindow;
}
window -title "3D Sword Creator" -widthHeight 300 200 myWindow;

//Create a layout
columnLayout;

//Create buttons for each section of the script
button -label "Create Blade" -command "createBlade()";
button -label "Create Guard" -command "createGuard()";
button -label "Create Hilt" -command "createHilt()";
button -label "Apply Shader" -command "applyShader()";

//Show the Window
showWindow myWindow;

//Define the functions for each button
global proc createBlade() {
    CreatePolygonCube;
    scale -r 1 8 1;
    rename "pCube1" "Blade";
    move 0 3 0;
    polySplit -ch 1 -sma 180 -ep 0 0.505771 -ep 1 0.505771 -ep 2 0.505771 -ep 3 0.505771 -ep 0 0.505771 |Blade|BladeShape;  select -cl;
    select -r Blade.vtx[9:10] ;
    move -r 0 1.106371 0 ;
}

global proc createGuard() {
    CreatePolygonCube;
    scale -r 5 1 1;
    rename "pCube1" "Guard";
    move 0 1.5 0;
    polySplit -ch 1 -sma 180 -ep 4 0.501551 -ep 8 0.498449 -ep 9 0.498449 -ep 5 0.501551 -ep 4 0.501551 |Guard|GuardShape;  select -cl;
    select -r Guard.vtx[8:11] ;
    scale -r -p 0cm 2.001551cm 0cm 1.244444 1 1 ;
}

global proc createHilt() {
    CreatePolygonCube;
    scale -r 1 3 1;
    rename "pCube1" "Hilt";
    move 0 10 0;
}

global proc applyShader() {
    polyUnite -ch 1 - mergeUVSets 1 -centerPivot -name Hilt Hilt guard Blade:
    doGroup 0 1 1;
    setAttr "openPBR_shader1.baseColor" -type double3 0.3123 0.3063 0;
    shadingNode -asShader lambert;
    set -renderable true -noSurfaceShader true -empty -name lambert25G;
    connectAttr -f lambert1 lambert2 "pCube1";
    sets -e -forceElement lambert25G;
    setAttr "lambert2.color" -type double3 0.3123 0.3063 0;
}

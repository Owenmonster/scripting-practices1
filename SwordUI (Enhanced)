//create a window
if (`window -exists myWindow`) {
    deleteUI myWindow;
}
window -title "3D Sword Creator" -widthHeight 300 200 myWindow;

//Create a tab layout
tabLayout myTabs;

//First Tab
columnLayout tab1;

text -label "This is the Blade tab. This is where you will create the blade for your sword";
text -label "You may only select one Blade type";
button -label "Create Blade" -command "createBlade()";
text -label "This Blade is a straight and poineded edge blade";
button -label "Create Blade2" -command "createBladeAlt()";
text -label "This Blade is a blade simular to the blades from God of War";
button -label "Create Blade3" -command "createBladeOther()";
setParent ..; 

//Second Tab
columnLayout tab2;
text -label "This is the Guard tab. This is where you will create the guard for your sword";
text -label "You may only select one Guard type";
button -label "Create Guard" -command "createGuard()";
text -label "This Guard is a basic and fault knightly style guard";
button -label "Create Guard2" -command "createGuardAlt()";
text -label "This Guard is a more curved then the first and simular to a half circle";
setParent ..;

//Third Tab
columnLayout tab3;
text -label "This is the Hilt tab. This is where you will create the hilt for your sword";
text -label "You may only select one Hilt type";
button -label "Create Hilt" -command "createHilt()";
text -label "This Hilt is just a default cube jut scaled up";
button -label "Create Hilt2" -command "createHiltAlt()";
text -label "This Hilt is simular to the first but only with a sword pommel";
setParent ..;

//Fourth Tab
columnLayout tab4;
text -label "This is the Shader tab. This is where you will slecet the colours for your sword";
button -label "Apply Shader" -command "applyShader()";
setParent ..;

//Set tab labels
tabLayout -edit
    -tabLabel tab1 "Blade"
    -tabLabel tab2 "Guard"
    -tabLabel tab3 "Hilt"
    -tabLabel tab4 "Shader"
    myTabs;


//Create a layout
columnLayout;

//Create buttons for each section of the script
button -label "Create Blade" -command "createBlade()";
button -label "Create Blade2" -command "createBladeAlt()";
button -label "Create Blade3" -command "createBladeOther()";
button -label "Create Guard" -command "createGuard()";
button -label "Create Guard2" -command "createGuardAlt()";
button -label "Create Hilt" -command "createHilt()";
button -label "Create Hilt2" -command "createHiltAlt()";
button -label "Apply Shader" -command "applyShader()";

//Show the Window
showWindow myWindow;

//Define the functions for each button
global proc createBlade() {
    CreatePolygonCube;
    scale -r 1 10 1;
    rename "pCube1" "Blade";
    move 0 4 0;
    polySplit -ch 1 -sma 180 -ep 0 0.505771 -ep 1 0.505771 -ep 2 0.505771 -ep 3 0.505771 -ep 0 0.505771 |Blade|BladeShape;  select -cl;
    select -r Blade.vtx[9:10] ;
    move -r 0 1.106371 0 ;
    polySplit -ch 1 -sma 180 -ep 4 0.812618 -ep 8 0.187382 -ep 9 0.187382 -ep 5 0.812618 -ep 4 0.812618 |Blade|BladeShape;  select -cl;

}

global proc createBladeAlt() {
    CreatePolygonCube;
    scale -r 1 10 1;
    rename "pCube1" "Blade";
    move 0 4 0;
    select -r Blade.vtx[2:5] ;
    scale -r -p 0cm 9cm 0cm 3.938805 1 1 ;
    polySplit -ch 1 -sma 180 -ep 4 0.826695 -ep 8 0.173305 -ep 9 0.173305 -ep 5 0.826695 -ep 4 0.826695 |Blade|BladeShape;  select -cl;
    select -r Blade.vtx[8:11] ;
    move -r -0.892337 0 0 ;
   select -r Blade.f[5] ;
   rotate -r -p -1.553542cm 3.133475cm 0cm -os -fo 0 0 11.632052 ;
   select -r Blade.vtx[0:1] Blade.vtx[6:7] ;
   move -r -0.05 0 0 ;
}

global proc createBladeOther() {
   CreatePolygonCylinder;
select -r pCylinder1 ;
scale -r 1 4.428487 1 ;
select -r pCylinder1.vtx[41] ;
move -r 0 1.942891 0 ;
select -r pCylinder1.vtx[20:39] ;
rotate -r -p -1.19209e-07cm 4.428487cm -1.78814e-07cm -os -fo 0 -146.184014 0 ;
move -r 0 -1.460543 0 ;
select -r pCylinder1.vtx[0:19] pCylinder1.vtx[40] ;
scale -r -p -1.19209e-07cm 0.818247cm -1.78814e-07cm 1 1 0.453187 ;
select -r pCylinder1.vtx[0:19] pCylinder1.vtx[40] ;
scale -r -p -1.19209e-07cm 0.818247cm -1.78814e-07cm 0.399052 1 1 ;
rename "pCylinder1" "Blade";
select -r Blade ;
move 0 6 0;
}


global proc createGuard() {
    CreatePolygonCube;
    scale -r 5 1 1;
    rename "pCube1" "Guard";
    move 0 1.5 0;
    polySplit -ch 1 -sma 180 -ep 4 0.501551 -ep 8 0.498449 -ep 9 0.498449 -ep 5 0.501551 -ep 4 0.501551 |Guard|GuardShape;  select -cl;
    select -r Guard.vtx[8:11] ;
    scale -r -p 0cm 2.001551cm 0cm 1.244444 1 1 ;
    select -r Guard ;
    scale -r 1 1 1.301965 ;
}

global proc createGuardAlt() {
    CreatePolygonCube;
    scale -r 5 1 1;
    rename "pCube1" "Guard";
    move 0 1.5 0;
    polySplit -ch 1 -sma 180 -ep 4 0.501551 -ep 8 0.498449 -ep 9 0.498449 -ep 5 0.501551 -ep 4 0.501551 |Guard|GuardShape;  select -cl;
    select -r Guard.vtx[0:1] Guard.vtx[6:7] ;
    scale -r -p 0cm 1cm 0cm 1.321576 1 1 ;
    select -cl  ;
    select -r Guard.vtx[2:5] Guard.vtx[8:11] ;
    move -r 0 0.478975 0 ;
    select -cl  ;
    select -r Guard.vtx[2:5] ;
    scale -r -p 0cm 2.478975cm 0cm 0.535025 1 1 ;
    select -r Guard ;
    scale -r 1 1 1.228523 ;    
}

global proc createHilt() {
    CreatePolygonCube;
    scale -r 1 3 1;
    rename "pCube1" "Hilt";
    move 0 0 0;
    select -r Hilt ;
    scale -r 1.126899 1 1.126899 ;
}

global proc createHiltAlt() {
    CreatePolygonCube;
    scale -r 1 3 1;
    rename "pCube1" "Hilt";
    move 0 0 0;
    select -r Hilt;
    scale -r 1.126899 1 1.126899;
    hilite -r Hilt ;
    polySplit -ch 1 -sma 180 -ep 4 0.141911 -ep 8 0.858089 -ep 9 0.858089 -ep 5 0.141911 -ep 4 0.141911 |Hilt|HiltShape;  select -cl;
    select -r Hilt.f[0] Hilt.f[2:5] ;
    polyExtrudeFacet -constructionHistory 1 -keepFacesTogether 1 -pvx 0 -pvy -1.287133455 -pvz 0 -divisions 1 -twist 0 -taper 1 -off 0 -thickness 0 -smoothingAngle 30 Hilt.f[0] Hilt.f[2:5];
// Result: polyExtrudeFace1
setAttr "polyExtrudeFace1.localTranslate" -type double3 0 0 0.202763 ;
}

//shader
global proc applyShader() {
    shadingNode -asShader lambert -name "myLambert";
sets -renderable true -noSurfaceShader true -empty -name "myLambertSG";
connectAttr -f "myLambert.outColor" "myLambertSG.surfaceShader";

select "Blade";
sets -e -forceElement "myLambertSG";
setAttr "myLambert.color" -type double3 0.535 0.535 0.535 ;
shadingNode -asShader lambert -name "myLambert1";
sets -renderable true -noSurfaceShader true -empty -name "myLambertSG1";
connectAttr -f "myLambert1.outColor" "myLambertSG1.surfaceShader";

select "Guard";
sets -e -forceElement "myLambertSG1";
setAttr "myLambert1.color" -type double3 2.708 2.283205 0 ;
shadingNode -asShader lambert -name "myLambert2";
sets -renderable true -noSurfaceShader true -empty -name "myLambertSG2";
connectAttr -f "myLambert2.outColor" "myLambertSG2.surfaceShader";

select "Hilt";
sets -e -forceElement "myLambertSG2";
setAttr "myLambert2.color" -type double3 0 0 0;
select -r Blade Hilt Guard ;
doGroup 0 1 1;
rename "group1" "Sword";
}


